{
  "name": "warphub-roster-data",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Импорт данных Wahapedia для Roster Builder (WarpHub) и тесты движка правил. Data: powered by Wahapedia.",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "data": "node scripts/import-wahapedia.mjs --src ./wahapedia-csv --out ../../backend/roster-data",
    "data:fetch": "node scripts/import-wahapedia.mjs --fetch --if-changed --src ./wahapedia-csv --out ../../backend/roster-data",
    "battlefield": "node --import tsx scripts/import-battlefield.ts --src ./40kdc-data"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
