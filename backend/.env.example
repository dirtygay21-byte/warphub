POSTGRES_URI=postgresql://user:password@localhost:5432/warphub
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
JWT_SECRET=change_me_to_random_string
BOT_INTERNAL_SECRET=change_me_to_random_string
INIT_DATA_MAX_AGE_SEC=86400
PORT=4000

# Базовый URL для Swagger Try it out (без завершающего /)
# Локально: http://127.0.0.1:4000/api
# PUBLIC_API_URL=https://warphub.ru/api

# Локальный адрес API для Swagger (по умолчанию http://localhost:4000)
# LOCAL_API_URL=http://localhost:4000

# Опционально: HTTP Basic Auth для /swagger (логин по умолчанию admin)
SWAGGER_USER=admin
SWAGGER_PASSWORD=

# MinIO / S3
S3_ENDPOINT=https://s3.warphub.ru
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=warphub
S3_PUBLIC_URL=https://s3.warphub.ru/warphub

# Дополнительные администраторы (Telegram ID через запятую).
# Двое администраторов из кода остаются всегда.
# ADMIN_TELEGRAM_IDS=123456789,987654321
# Один дополнительный администратор (старое имя, работает вместе с ADMIN_TELEGRAM_IDS)
# ADMIN_TELEGRAM_ID=123456789

# Уведомления через бота (on по умолчанию). off — например, на тестовом сервере.
# TELEGRAM_NOTIFICATIONS=on

# Roster Builder (скрытый раздел по коду доступа)
# Кто может создавать коды (Telegram ID через запятую). Пусто — все администраторы.
# ROSTER_ADMIN_TELEGRAM_IDS=123456789
# Срок жизни кода, часов (по умолчанию 24)
# ROSTER_CODE_TTL_HOURS=24
# Папка с данными Wahapedia (по умолчанию ./roster-data рядом с backend)
# ROSTER_DATA_DIR=/srv/warphub/backend/roster-data

# Экспорт битв на сайт Dominatus
DOMINATUS_API_URL=https://warp-dominatus.ru
DOMINATUS_INTEGRATION_TOKEN=change_me_to_random_string

# Сохранение полного JSON битвы в отдельную ветку GitHub
DOMINATUS_GITHUB_TOKEN=change_me_to_github_pat
DOMINATUS_GITHUB_REPOSITORY=dirtygay21-byte/warphub
DOMINATUS_GIT_BRANCH=dominatus-battles
# DOMINATUS_GIT_API_URL=https://api.github.com
