,"minRange":0,"maxRange":1,"attacks":3,"strength":3,"dmgHit":1,"dmgCrit":3},{"runemark":"ranged","minRange":0,"maxRange":12,"attacks":2,"strength":3,"dmgHit":1,"dmgCrit":4}]},{"id":"d7ee917f","name":"Huachi","subfaction":"The Starblood Stalkers","movement":6,"toughness":3,"wounds":10,"points":95,"runemarks":["minion"],"weapons":[{"runemark":"dagger","minRange":0,"maxRange":1,"attacks":3,"strength":3,"dmgHit":1,"dmgCrit":3},{"runemark":"spear","minRange":0,"maxRange":8,"attacks":1,"strength":3,"dmgHit":1,"dmgCrit":4}]},{"id":"76ecea40","name":"Kixi-Taka, The Diviner","subfaction":"The Starblood Stalkers","movement":6,"toughness":3,"wounds":18,"points":130,"runemarks":["hero","minion"],"weapons":[{"runemark":"club","minRange":0,"maxRange":2,"attacks":3,"strength":3,"dmgHit":1,"dmgCrit":4},{"runemark":"blast","minRange":3,"maxRange":7,"attacks":2,"strength":3,"dmgHit":3,"dmgCrit":6}]},{"id":"1e35ab7c","name":"Klaq-Trok","subfaction":"The Starblood Stalkers","movement":4,"toughness":5,"wounds":28,"points":175,"runemarks":["warrior"],"weapons":[{"runemark":"club","minRange":0,"maxRange":1,"attacks":4,"strength":4,"dmgHit":2,"dmgCrit":4}]},{"id":"ffguvt5r","name":"Kro-Jax, the Aegis","subfaction":"Jaws of Itzl","movement":4,"toughness":5,"wounds":30,"points":240,"runemarks":["hero","warrior"],"weapons":[{"runemark":"club","minRange":0,"maxRange":1,"attacks":4,"strength":5,"dmgHit":3,"dmgCrit":5}]},{"id":"bolny32m","name":"So-Kar","subfaction":"Jaws of Itzl","movement":4,"toughness":4,"wounds":16,"points":140,"runemarks":["bulwark","warrior"],"weapons":[{"runemark":"sword","minRange":0,"maxRange":1,"attacks":4,"strength":4,"dmgHit":2,"dmgCrit":4}]},{"id":"f72cfa5c","name":"Ro-Tak, the Guardian","subfaction":"Jaws of Itzl","movement":4,"toughness":4,"wounds":16,"points":150,"runemarks":["bulwark","warrior"],"weapons":[{"runemark":"spear","minRange":0,"maxRange":2,"attacks":4,"strength":4,"dmgHit":2,"dmgCrit":4}]}],"abilities":[{"id":"7e0c051b","name":"Cold-blooded Commander","cost":"double","text":"A fighter can only use this ability if an enemy fighter has been taken down by an attack action made by them this activation. This fighter makes a bonus move action or a bonus attack action.","runemarks":["hero"]},{"id":"fc86e672","name":"Hunting Pack","cost":"double","text":"Pick a visible friendly fighter with the Beast runemark within 2\" of this fighter. That fighter makes a bonus attack action.","runemarks":["trapper"]},{"id":"2f33cac4","name":"Lead from On High","cost":"double","text":"Add 3 to this fighter's Move characteristic for their next move action in this activation.","runemarks":["hero","agile"]},{"id":"9dc1bf09","name":"Nimble Retreat","cost":"double","text":"A fighter can only use this ability if they are within 1\" of an enemy fighter. This fighter makes a bonus disengage action.","runemarks":["minion"]},{"id":"eece11bc","name":"Tide of Serpents","cost":"double","text":"Pick a visible enemy fighter within 8\" of this fighter and roll a number of dice equal to the value of this ability. For each roll of 4-5, allocate 1 damage point to that fighter. For each roll of 6, allocate 3 damage points to that fighter.","runemarks":["hero","priest"]},{"id":"b4a104fc","name":"Voracious Appetite","cost":"double","text":"Pick a visible enemy fighter within 1\" of this fighter and roll a number of dice equal to the value of this ability. For each roll of 4+, allocate 1 damage point to that fighter.","runemarks":["destroyer"]},{"id":"53e140fc","name":"Lords of Space and Time","cost":"triple","text":"Pick another friendly fighter with the Seraphon faction runemark that is within 12\" of this fighter. Remove that fighter from the battlefield, then set that fighter up on a platform or the battlefield floor, wholly within a number of inches of this fighter equal to the value of this ability.","runemarks":["mystic","hero"]},{"id":"0bcb02c6","name":"Meteoric Barrage","cost":"triple","text":"Until the end of this fighter's activation, the next time this fighter finishes a move action within 1\" of an enemy fighter, pick a visible enemy fighter within 1\" of this fighter. Allocate a number of damage points to that fighter equal to the value of this ability.","runemarks":["frenzied"]},{"id":"7a97b023","name":"Tearing Bite","cost":"triple","text":"Add the value of this ability to the damage points allocated by each hit and critical hit from the next melee attack action made by this fighter in this activation.","runemarks":["warrior"]},{"id":"9fb8d738","name":"Revivifying Energies","cost":"quad","text":"Remove a number of damage points up to the value of this ability allocated to each friendly fighter within 6\" of this fighter.","runemarks":["hero","icon-bearer"]},{"id":"339d66b0","name":"Wrath of the Old Ones","cost":"quad","text":"Until the end of the battle round, add half the value of this ability (rounding up) to the Attacks and Strength characteristics of melee attack actions made by this fighter.","runemarks":[]},{"id":"72ea88ae","name":"Starborn","cost":"reaction","text":"A fighter can make this reaction after they are targeted by a melee attack action but before the hit rolls are made. Count up to two critical hits from that attack action as hits instead.","runemarks":[]},{"id":"2ba76301","name":"Predatory Leap","cost":"triple","text":"This fighter makes a bonus move action up to 3\" and can fly as part of that move action. After this fighter finishes that move, you can pick a visible enemy fighter within 1\" of this fighter. If you do so, allocate a number of damage points equal to half the value of this ability (rounding up) to that fighter.","runemarks":["warrior","mount"]},{"id":"5851f8af","name":"Brutal Blows","cost":"double","text":"A fighter can only use this ability if they are within 1\" of 2 or more enemy fighters. Add half the value of this ability (rounding up) to the Attacks characteristic of the next melee attack action made by this fighter.","runemarks":["brute"]},{"id":"a2bd176b","name":"Spawn of Sotek","cost":"double","text":"Add 2 to the Attacks characteristic of melee attack actions made by this fighter this activation while 1 or more endangered friendly fighters are within 6\" of them. A friendly fighter is endangered if it has the Minion runemark and is: within 1\" of 1 or more enemy fighters and/or has 1 or more damage points allocated to them.","runemarks":["sentience"]},{"id":"b11571a1","name":"Raptadon Tactics","cost":"double","text":"If this fighter has a weapon with the Ranged Weapon runemark on their fighter profile, this fighter makes a bonus move action of a number of inches equal to the value of this ability. Otherwise, add 2 to the Attacks characteristic of this fighter's melee attack actions until the end of their activation.","runemarks":["minion","mount"]},{"id":"d4de5fe6","name":"Seraphon","cost":"battletrait","text":"After you pick your warband, pick either Coalesced or Starborne and gain the corresponding battle trait listed below:Coalesced:Friendly fighters with this battle trait can add a 1 to the value of any [triple] spent to use the Tearing bite ability, to a maximum of 6. Starborne:Fighters with this battle trait can make the ‘Starborn’ reaction when they are targeted by melee and missile attack actions.","runemarks":[]},{"id":"fa891e0e","name":"Chameleon Ambush","cost":"double","text":"This fighter can use this ability only if there are no visible enemy fighters within 12\" of this fighter. This fighter makes a bonus move action.","runemarks":["scout"],"subfaction":"The Starblood Stalkers"},{"id":"da1dd1e6","name":"Imbue with Azyrite Energy","cost":"triple","text":"Until the end of the battle round, add 1 to the Move and Toughness characteristics of friendly fighters while they are within 9\" of this fighter.","runemarks":["hero"],"subfaction":"The Starblood Stalkers"},{"id":"d117d47a","name":"Sotek's Venomites","cost":"double","text":"If no enemy fighter has a Sotek's Venomites token, pick a visible enemy fighter within 6\" of this fighter and give them a Sotek's Venomites token for the rest of the battle. While that enemy fighter has that token, if a melee attack action that targets that enemy fighter scores any critical hits, allocate D3 damage points to that enemy fighter. If a fighter with a Sotek's Venomites token is removed from the battlefield, remove that Sotek's Venomites from the battlefield.","runemarks":[],"subfaction":"Jaws of Itzl"},{"id":"918989e6","name":"Dedicated Guardian","cost":"double","text":"Until the end of the battle round, friendly fighters with the Hero runemark and the Jaws of Itzl runemark cannot be targeted while they are within 1\" of this fighter.","runemarks":["bulwark"],"subfaction":"Jaws of Itzl"},{"id":"11cf198c","name":"Sunblooded Quickening","cost":"quad","text":"Until the start of this fighter's next activation, add 3 to the Move characteristic of visible friendly fighters with the Seraphon runemark that do not have the Mount or Fly runemarks and that start their activation within 6\" of this fighter.","runemarks":["hero"],"subfaction":"Jaws of Itzl"}]}
