ters":22},{"id":"stormcast-eternals-warrior-chamber","name":"Stormcast Eternals Warrior Chamber","grandAlliance":"order","generic":false,"subfactions":["Steelheart's Champions"],"fighters":44},{"id":"sylvaneth","name":"Sylvaneth","grandAlliance":"order","generic":false,"subfactions":["Ylthari's Guardians","Skaeth's Wild Hunt","Heralds of Kurnoth"],"fighters":34},{"id":"twistweald","name":"Twistweald","grandAlliance":"order","generic":false,"subfactions":[],"fighters":7},{"id":"vulkyn-flameseekers","name":"Vulkyn Flameseekers","grandAlliance":"order","generic":false,"subfactions":[],"fighters":7},{"id":"wildercorps-hunters","name":"Wildercorps Hunters","grandAlliance":"order","generic":false,"subfactions":[],"fighters":11},{"id":"ydrilan-riverblades","name":"Ydrilan Riverblades","grandAlliance":"order","generic":false,"subfactions":[],"fighters":7}],"universal":[{"id":"e9de24c7","name":"Rush","cost":"double","text":"Add 1 to the Move characteristic of this fighter until the end of their activation.","runemarks":[]},{"id":"40099170","name":"Onslaught","cost":"triple","text":"Add 1 to the Attacks characteristic of melee attack actions made by this fighter until the end of their activation.","runemarks":[]},{"id":"04bd58bb","name":"Respite","cost":"double","text":"A fighter cannot use this ability if they are within 1\" of any enemy fighters. Remove a number of damage points allocated to this fighter equal to the value of this ability.","runemarks":[]},{"id":"d04e3a07","name":"Inspiring Presence","cost":"triple","text":"Pick a visible friendly fighter within 6\" of this fighter that has not activated yet this battle round. You can activate that fighter immediately after this fighter's activation ends.","runemarks":["hero"]},{"id":"8e7f9b93","name":"Reckoning","cost":"quad","text":"If half or more of the fighters in your warband are taken down, this fighter can make a bonus move action of a number of inches up to the value of this ability. Then, if they are within 1\" of any enemy fighters, they can make a bonus attack action.","runemarks":[]},{"id":"fe2713fc","name":"Binding Ropes","cost":"double","text":"Pick an enemy monster within 1\" of this fighter and roll a number of dice equal to the value of this ability. For each 4+, subtract 1 from the Move characteristic of that monster (to a minimum of 3) until the end of the battle.","runemarks":[]},{"id":"5c47cc25","name":"Go for the Eyes","cost":"triple","text":"If the next attack action made by this fighter this activation that targets an enemy monster scores any critical hits, subtract 1 from the Attacks characteristic (to a minimum of 1) of attack actions made by that monster until the end of the battle.","runemarks":[]},{"id":"d53cedf3","name":"Taunt","cost":"quad","text":"Pick a visible enemy monster within 6\" of this fighter and roll a number of dice equal to the value of this ability. If a 4+ is rolled on any of the dice, then until the end of the battle round or until this fighter is taken down, attack actions made by that monster must target this fighter.","runemarks":[]},{"id":"68a583a2","name":"Counter","cost":"reaction","text":"A fighter can make this reaction after they are targeted by a melee attack action but before the hit rolls are made. If there are any unmodified hit rolls of 1, allocate 2 damage points to the attacking fighter. In addition, if there are 2 or more hit rolls from that attack action that miss, allocate 1 damage point to the attacking fighter.","runemarks":[]},{"id":"7095764c","name":"Take Cover","cost":"reaction","text":"A fighter that is in cover can make this reaction after they are targeted by a missile attack action but before the hit rolls are made. After the hit rolls have been made, roll a dice for each critical hit. On a 4+, that critical hit becomes a hit instead. Fighters with the Mount runemark cannot make this reaction.","runemarks":[]},{"id":"fddbbcf5","name":"Strike Them Down","cost":"reaction","text":"A fighter can make this reaction when a visible enemy fighter within 1\" of them makes a disengage action but before that fighter moves away. Roll a dice. On a 4+, allocate D6 damage points to that enemy fighter.","runemarks":[]},{"id":"7588a039","name":"Monstrous Reach","cost":"double","text":"Until the end of this monster's activation, do not count the vertical distance when measuring the range for attack actions made by this monster.","runemarks":["monster"]},{"id":"f6ddb62f","name":"Drag and Maul","cost":"triple","text":"Pick a visible enemy fighter within 6\" of this monster. Remove that fighter from the battlefield and set them up within 1\" of this monster. Then, roll a number of dice equal to the value of this ability. For each 4+, allocate 3 damage points to that fighter.","runemarks":["monster"]},{"id":"c382b2b8","name":"Demolishing Rampage","cost":"quad","text":"Pick a terrain feature within 1\" of this monster. In an order of your choice, place each objective, treasure token and fighter that is on that terrain feature, and on any other terrain feature that is on that terrain feature, on the battlefield floor in a location of your choice as close as possible horizontally to its current location. Then, in an order of your choice, each fighter placed on the battlefield in this manner suffers impact damage. Then, remove the terrain feature(s).","runemarks":["monster"]}]}
