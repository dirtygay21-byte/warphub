:0,"maxRange":1,"attacks":5,"strength":5,"dmgHit":2,"dmgCrit":5}]},{"id":"11986e06","name":"Ammis Dawnguard","subfaction":"Stormsire's Cursebreakers","movement":4,"toughness":5,"wounds":22,"points":160,"runemarks":["mystic"],"weapons":[{"runemark":"mace","minRange":0,"maxRange":1,"attacks":4,"strength":5,"dmgHit":2,"dmgCrit":5}]},{"id":"aa9cb0c7","name":"Rastus the Charmed","subfaction":"Stormsire's Cursebreakers","movement":4,"toughness":5,"wounds":22,"points":160,"runemarks":["mystic"],"weapons":[{"runemark":"mace","minRange":0,"maxRange":1,"attacks":4,"strength":6,"dmgHit":2,"dmgCrit":4}]},{"id":"438b81dc","name":"Averon Stormsire","subfaction":"Stormsire's Cursebreakers","movement":4,"toughness":5,"wounds":30,"points":215,"runemarks":["hero","frenzied"],"weapons":[{"runemark":"mace","minRange":0,"maxRange":2,"attacks":3,"strength":4,"dmgHit":2,"dmgCrit":4},{"runemark":"blast","minRange":3,"maxRange":7,"attacks":2,"strength":4,"dmgHit":3,"dmgCrit":6}]}],"abilities":[{"id":"17c7c7d4","name":"Channelled Empowerment","cost":"double","text":"Add the value of this ability to the Strength characteristic of the next melee attack action made by this fighter in this activation. Fighters with the Beast  runemark cannot use this ability.","runemarks":[]},{"id":"0c743bc2","name":"Cleanse the Realms of Taint","cost":"double","text":"A fighter can only use this ability if an enemy fighter has been taken down by an attack action made by them this activation. This fighter makes a bonus move action or a bonus attack action.","runemarks":["hero"]},{"id":"89d633d2","name":"Meteoric Slam","cost":"double","text":"Until the end of this fighter's activation, add 1 to the Attacks and Strength characteristics of melee attack actions made by this fighter.","runemarks":["hero","brute"]},{"id":"d4790a75","name":"Summon Celestial Lightning","cost":"double","text":"Pick a visible enemy fighter within 1\" of this fighter and roll a number of dice equal to the value of this ability. For each roll of 4+, allocate 1 damage point to that enemy fighter.","runemarks":["mystic"]},{"id":"4c650b05","name":"Burst of Celestial Lightning","cost":"triple","text":"Add half the value of this ability (rounding up) to the damage points allocated to enemy fighters by each hit and critical hit from the next missile attack action made by this fighter this activation.","runemarks":["destroyer"]},{"id":"b10cbb4f","name":"Darting Attack","cost":"triple","text":"This fighter makes a bonus attack action. Then, they can make a bonus disengage action.","runemarks":["beast"]},{"id":"d6de3d94","name":"Shatter Spirit Flask","cost":"triple","text":"Allocate a number of damage points equal to the value of this ability to this fighter and to all visible fighters within 3\" of this fighter.","runemarks":["hero","berserker"]},{"id":"68419ac4","name":"Soul-shield Channelling","cost":"triple","text":"Until the end of the battle round, count each critical hit from attack actions that target this fighter as a hit instead.","runemarks":["bulwark"]},{"id":"84ec2ed7","name":"Open Redemption Cache","cost":"quad","text":"Allocate a number of damage points equal to the value of this ability to all visible enemy fighters within 3\" of this fighter.","runemarks":["frenzied"]},{"id":"34ececfd","name":"Thunderous Pounce","cost":"quad","text":"Until the end of this fighter's activation, the next time this fighter finishes a move action within 1\" of an enemy fighter, pick a visible enemy fighter within 1\" of this fighter. Allocate a number of damage points to that fighter equal to double the value of this ability.","runemarks":["ferocious"]},{"id":"872ecca8","name":"Thunderous Departure","cost":"reaction","text":"A fighter can make this reaction when they are targeted by a melee attack action, after the damage is totalled but before it is allocated to this fighter, if it is enough for this fighter to be taken down. Allocate D6 damage points to their attacker. Fighters with the Beast  runemark or both the Scout  and Fly  runemarks cannot make this reaction.","runemarks":[]},{"id":"af254288","name":"Scions of the Storm","cost":"battletrait","text":"After deployment, you can pick a friendly fighter with this battle trait. If that fighter is on the battlefield, remove them from the battlefield. At the start of the second battle round onwards, starting with the attacker, you can place that fighter on the battlefield more than 5\" from each enemy fighter and more than 3\" from each objective and treasure token.","runemarks":[]},{"id":"38af3e28","name":"Storm of Eldritch Lightning","cost":"triple","text":"Pick a visible enemy fighter within 9\" of this fighter and roll a number of dice equal to the value of this ability.  For each 3+, allocate 3 damage points to that fighter.","runemarks":["hero"],"subfaction":"Stormsire's Cursebreakers"}]}
