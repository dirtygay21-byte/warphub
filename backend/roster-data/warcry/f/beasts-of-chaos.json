mgHit":1,"dmgCrit":4}]},{"id":"ee7ac29e","name":"Murghoth Half-Horn","subfaction":"Grashrak's Despoilers","movement":5,"toughness":3,"wounds":10,"points":65,"runemarks":[],"weapons":[{"runemark":"spear","minRange":0,"maxRange":2,"attacks":3,"strength":3,"dmgHit":1,"dmgCrit":4}]},{"id":"c037429d","name":"Gnarl","subfaction":"Grashrak's Despoilers","movement":5,"toughness":3,"wounds":10,"points":85,"runemarks":["scout"],"weapons":[{"runemark":"dagger","minRange":0,"maxRange":1,"attacks":2,"strength":3,"dmgHit":1,"dmgCrit":3},{"runemark":"ranged","minRange":3,"maxRange":15,"attacks":2,"strength":3,"dmgHit":1,"dmgCrit":3}]},{"id":"d44b75b4","name":"Ushkor","subfaction":"Grashrak's Despoilers","movement":5,"toughness":3,"wounds":10,"points":85,"runemarks":["scout"],"weapons":[{"runemark":"dagger","minRange":0,"maxRange":1,"attacks":2,"strength":3,"dmgHit":1,"dmgCrit":3},{"runemark":"ranged","minRange":3,"maxRange":15,"attacks":2,"strength":3,"dmgHit":1,"dmgCrit":3}]},{"id":"6d70c1b4","name":"Draknar","subfaction":"Grashrak's Despoilers","movement":5,"toughness":4,"wounds":18,"points":125,"runemarks":["warrior"],"weapons":[{"runemark":"axe","minRange":0,"maxRange":1,"attacks":3,"strength":4,"dmgHit":2,"dmgCrit":5}]},{"id":"c810fb18","name":"Grashrak Fellhoof","subfaction":"Grashrak's Despoilers","movement":5,"toughness":4,"wounds":25,"points":185,"runemarks":["hero","mystic"],"weapons":[{"runemark":"club","minRange":0,"maxRange":2,"attacks":3,"strength":3,"dmgHit":2,"dmgCrit":4},{"runemark":"blast","minRange":3,"maxRange":7,"attacks":2,"strength":3,"dmgHit":3,"dmgCrit":6}]}],"abilities":[{"id":"f1a9eba3","name":"Bloodgorge","cost":"double","text":"A fighter can only use this ability if an enemy fighter has been taken down by an attack action made by them this activation. Remove a number of damage points allocated to this fighter up to the value of this ability.","runemarks":["brute"]},{"id":"1c42f884","name":"Brayherd Ambush","cost":"double","text":"A fighter can only use this ability if it is the first battle round. This fighter can make a bonus move action up to a number of inches equal to the value of this ability.","runemarks":[]},{"id":"d6bef6fd","name":"Devolve","cost":"double","text":"Pick a visible enemy fighter within 6\" of this fighter. That enemy fighter makes a bonus move action directly towards this fighter, as if they were jumping, a number of inches equal to the value of this ability. When doing so, they can move away from enemy fighters within 1\" at the start of that move action.","runemarks":["hero","mystic"]},{"id":"33c7d45b","name":"Rip, Gore and Tear!","cost":"double","text":"A fighter can only use this ability if an enemy fighter has been taken down by an attack action made by them this activation. This fighter makes a bonus move action or a bonus attack action.","runemarks":["hero"]},{"id":"1f49c5fc","name":"Bestial Charge","cost":"triple","text":"Until the end of this fighter's activation, the next time this fighter finishes a move action within 1\" of an enemy fighter, pick a visible enemy fighter within 1\" of this fighter. Allocate a number of damage points to that fighter equal to the value of this ability.","runemarks":["warrior"]},{"id":"9f714195","name":"Grisly Trophy","cost":"triple","text":"A fighter can only use this ability if an enemy fighter has been taken down by an attack action made by them this activation. Until the end of the battle round, add 1 to the Attacks characteristic of melee attack actions made by visible friendly fighters while they are within 9\" of this fighter.","runemarks":["hero","champion"]},{"id":"9d2b4844","name":"Petrifying Gaze","cost":"triple","text":"Pick a visible enemy fighter within 8\" of this fighter and roll a dice. On a roll of 2+, allocate a number of damage points to that fighter equal to the roll. In addition, until the end of the battle round, subtract 1 from the Move characteristic of that fighter (to a minimum of 1).","runemarks":["berserker"]},{"id":"b406c9c6","name":"Volley of Arrows","cost":"triple","text":"Add half the value of this ability (rounding up) to the Attacks characteristic of the next missile attack action made by this fighter in this activation.","runemarks":["scout"]},{"id":"6e95ab56","name":"Bring Down the Storm","cost":"triple","text":"Pick a visible enemy fighter within 20\" of this fighter and roll a dice. On a roll of 2+, allocate a number of damage points to that fighter equal to the value of this ability.","runemarks":["destroyer"]},{"id":"f1cade78","name":"Empowering Lightning","cost":"quad","text":"Remove a number of damage points up to the value of this ability allocated to each friendly fighter with both the Beasts of Chaos faction runemark and the Destroyer runemark within 9\" of this fighter.","runemarks":["hero","destroyer"]},{"id":"8e6dc5a6","name":"Brute Resilience","cost":"reaction","text":"A fighter can make this reaction when they are targeted by a melee attack action but before the hit rolls are made. Subtract 1 from the damage points allocated to this fighter by each hit from that attack action (to a minimum of 1).","runemarks":[]},{"id":"3647d6ce","name":"Beastman Ambush","cost":"battletrait","text":"After deployment, you can pick a friendly fighter from each battle group that is on the battlefield. Remove those fighters from the battlefield. At the start of battle rounds 2, 3, and 4, you can place one of those fighters on the battlefield, more than 6\" from each enemy fighter and wholly within 3\" of one or more battlefield edges.","runemarks":[]},{"id":"fbce3d1d","name":"Savage Bolt","cost":"quad","text":"Pick a visible enemy fighter within 12\" of this fighter.  Allocate a number of damage points to that fighter equal to the value of this ability. Then, roll a die. On a 2+, that fighter cannot activate this round.","runemarks":["hero"],"subfaction":"Grashrak's Despoilers"}]}
