{
  "name": "warphub-roster-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "WarpHub Roster Builder — внутренний конструктор ростеров Warhammer 40,000 (11-я редакция). Data: powered by Wahapedia.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "data": "node scripts/import-wahapedia.mjs --src ./wahapedia-csv --out ./public/data",
    "data:fetch": "node scripts/import-wahapedia.mjs --fetch --if-changed --src ./wahapedia-csv --out ./public/data"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
